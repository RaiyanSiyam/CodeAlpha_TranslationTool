PORT=3001

# libretranslate | google | azure
TRANSLATE_PROVIDER=libretranslate

# LibreTranslate (default — no key required for light public-instance use)
LIBRETRANSLATE_URL=https://translate.bark.lgbt
# LIBRETRANSLATE_API_KEY=

# Google Cloud Translation (only if TRANSLATE_PROVIDER=google)
# GOOGLE_TRANSLATE_API_KEY=

# Microsoft Azure Translator (only if TRANSLATE_PROVIDER=azure)
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
